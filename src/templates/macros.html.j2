{% macro lvl(k) %}<span class="lvl lvl-{{ k }}">{{ C.NIVEAUX[k][0] }}</span>{% endmacro %}

{% macro who(n, label=None) %}{% if n == 'all' %}<span class="who who-all">Tous</span>{% else %}<span class="who who-{{ n }}">{{ label or ('É' ~ n) }}</span>{% endif %}{% endmacro %}

{% macro owners(st) %}{% if not st.h or st.h|length == 5 %}{{ who('all') }}{% else %}{% for n in st.h|dictsort %}{{ who(n[0]) }}{% endfor %}{% endif %}{% endmacro %}

{% macro q(qid, ref=True) %}{% set x = quote(qid) %}<span class="q">«&nbsp;{{ x.txt|fr }}&nbsp;»</span>{% if ref %} <span class="ref">{{ x.loc }}, p.&nbsp;{{ x.page }}</span>{% endif %}{% endmacro %}

{% macro days(st) %}{% set a, b = st.j %}{% if a == 11 %}Jour J{% elif a == b %}J{{ a }}{% else %}J{{ a }}–J{{ b }}{% endif %}{% endmacro %}

{% macro sec(key, num, title, first=False) %}<h1 class="sec{% if first %} first{% endif %}" data-toc="{{ key }}" data-title="{{ num }}{{ title }}"><span class="num">{{ num }}</span>{{ title|fr }}</h1>{% endmacro %}

{% macro toc(items, pages) %}
<ol class="toc">
{% for key, num, title in items %}
  <li><span class="n">{{ num }}</span><span class="t">{{ title|fr }}</span><span class="p">{{ pages.get(key, '··') }}</span></li>
{% endfor %}
</ol>
{% endmacro %}

{% macro zellige() %}
<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <pattern id="z" width="50" height="50" patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#fff" stroke-width="1.6">
        <rect x="12.5" y="12.5" width="25" height="25"/>
        <rect x="12.5" y="12.5" width="25" height="25" transform="rotate(45 25 25)"/>
        <circle cx="25" cy="25" r="5.5"/>
        <path d="M0 0 L7 7 M50 0 L43 7 M0 50 L7 43 M50 50 L43 43"/>
      </g>
    </pattern>
  </defs>
  <rect width="200" height="200" fill="url(#z)"/>
</svg>
{% endmacro %}

{% macro cover(doctype, role=None, meta=[], mission=None, contents=None) %}
<section class="cover">
  <div class="band">
    {{ zellige() }}
    <div class="inner">
      <div class="eyebrow">{{ C.META.groupe }} · Français · Lycée</div>
      <h1>{{ C.META.titre|fr }}</h1>
      <div class="sub">Étude de <em>{{ C.META.oeuvre }}</em> — {{ C.META.auteur }}</div>
    </div>
  </div>
  <div class="doc">
    <div class="doctype">{{ doctype|fr }}{% if role %}<span class="role">{{ role|fr }}</span>{% endif %}</div>
    <div class="accent"></div>
    <div class="meta">
      {% for k, v in meta %}
      <div class="k">{{ k }}</div>{% if v %}<div>{{ v|fr }}</div>{% else %}<div class="fill"></div>{% endif %}
      {% endfor %}
    </div>
    {% if mission %}<div class="mission">{{ mission|fr }}</div>{% endif %}
  </div>
  <div class="foot"><span>{{ C.META.version }} · {{ C.META.date }}</span><span>Document de travail du groupe — à ne pas diffuser hors de la classe</span></div>
</section>
{% endmacro %}

{% macro levels_legend() %}
<div class="grid3">
{% for k in ['EXIGE', 'RECO', 'HYPO'] %}
  <div class="box line"><div>{{ lvl(k) }}</div><p class="small" style="margin:1.6mm 0 0">{{ C.NIVEAUX[k][1]|fr }}</p></div>
{% endfor %}
</div>
{% endmacro %}

{% macro compte_rendu(n=None) %}
<section class="cr-page">
  <h1 class="sec first" style="break-before:auto"><span class="num">✎</span>Compte rendu</h1>
  <p class="muted small">À remplir les jours 2, 4, 6 et 8, à envoyer au groupe avant 20&nbsp;h. Photocopier cette page si besoin.</p>
  {% for f in C.ORGANISATION.compte_rendu %}
  <div class="field"><div class="k">{{ f|fr }}</div><div class="v">{% if n and loop.first %}<span style="font-size:9pt">Élève {{ n }}</span>{% endif %}</div></div>
  {% endfor %}
  <h3 style="margin-top:6mm">Notes libres</h3>
  <div class="ruled">{% for i in range(17) %}<div></div>{% endfor %}</div>
</section>
{% endmacro %}

{% macro attente_box() %}
<div class="box wait keep">
  <div class="kicker">Partie D en attente · décision au plus tard au {{ C.ATTENTE_D.reprise|lower }}</div>
  <p class="small">{{ C.ATTENTE_D.statut|fr }} <strong>{{ C.ATTENTE_D.exige|fr }}</strong></p>
  <p class="small">{{ C.ATTENTE_D.pourquoi|fr }}</p>
  <p class="small" style="margin:0">{{ C.ATTENTE_D.pret|fr }}</p>
</div>
{% endmacro %}
