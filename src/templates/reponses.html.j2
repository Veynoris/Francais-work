{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}G4 — Élève {{ n }}{% endblock %}
{% block hl %}Groupe 4 · Élève {{ n }} · {{ C.ELEVES[n].court }}{% endblock %}
{% block hr %}{{ C.META.oeuvre }}{% endblock %}
{% block body %}
<div class="rep-head">
  <div class="band-s">{{ m.zellige() }}
    <div class="inner">
      <div class="eyebrow">{{ C.META.groupe }} · {{ C.META.titre|fr }}</div>
      <h1>Élève {{ n }} · {{ C.ELEVES[n].court|fr }}</h1>
    </div>
  </div>
</div>

{% if n == 1 %}
<p>{{ C.CONSIGNE.intro|fr }}</p>
{% for code, t in C.CONSIGNE.axes %}
<section class="rep">
  <h2 class="rep-sec">{{ loop.index }}. {{ t|fr }}</h2>
  <ul class="ans">
  {% for q in rows if q.axe == code %}<li><span class="q">«&nbsp;{{ q.txt|fr }}&nbsp;»</span> <span class="ref">(p.&nbsp;{{ q.page }})</span></li>{% endfor %}
  </ul>
</section>
{% endfor %}
{% else %}
{% for sec in r.sections %}
<section class="rep">
  <h2 class="rep-sec">{% if sec.code in qtxt %}{{ sec.code }}. {{ qtxt[sec.code]|fr }}{% else %}{{ sec.titre|fr }}{% endif %}</h2>
  {% for kind, val in sec.blocs %}
    {% if kind in ('cle', 'these') %}<p class="cle">{{ val|ans }}</p>
    {% elif kind == 'h' %}<h3>{{ val|fr }}</h3>
    {% elif kind == 'trois' %}<table class="trois keep"><tbody>{% for a, b in val %}<tr><td class="strong" style="width:36mm">{{ a|fr }}</td><td>{{ b|fr }}</td></tr>{% endfor %}</tbody></table>
    {% elif kind == 'script' %}<div class="script">{% for it in val %}{% if it|length == 2 %}{% if it[0] %}<h3 class="temps">{{ it[0]|fr }}</h3>{% endif %}<p class="dida">{{ it[1]|fr }}</p>{% else %}<p class="rep-line"><span class="who-s">{{ it[0] }}</span>{% if it[1] %} <span class="dida-i">({{ it[1]|fr }})</span>{% endif %} {{ it[2]|fr }}</p>{% endif %}{% endfor %}</div>
    {% elif kind == 'ul' %}<ul class="ans">{% for t in val %}<li>{{ t|ans }}</li>{% endfor %}</ul>
    {% elif kind == 'ol' %}<ol class="ans">{% for t in val %}<li>{{ t|ans }}</li>{% endfor %}</ol>
    {% else %}<p>{{ val|ans }}</p>{% endif %}
  {% endfor %}
</section>
{% endfor %}
{% endif %}
{% endblock %}
